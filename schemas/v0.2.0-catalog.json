  "artifact_list": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List registered text artifacts for the project or task.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "Resume",
      "type": "object"
    },
    "name": "artifact_list"
  },
