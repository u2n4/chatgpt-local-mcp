  "file_patch": {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Apply hash-checked whole-text replacements with a recovery journal.",
    "inputSchema": {
      "$defs": {
        "Edit": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "maxLength": 262144,
              "title": "Content",
              "type": "string"
            },
            "expected_hash": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expected Hash"
            },
            "path": {
              "maxLength": 768,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "path",
            "content",
            "expected_hash"
          ],
          "title": "Edit",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "edits": {
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Edits",
          "type": "array"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Operation Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "operation_id",
        "edits"
      ],
      "title": "Patch",
      "type": "object"
    },
    "name": "file_patch"
  },
